        "jsCode": "const files = items.map(item => ({\n  id: item.json.id,\n  name: item.json.name,\n  mimeType: item.json.file?.mimeType,\n  size: item.json.size,\n  lastModifiedDateTime: item.json.lastModifiedDateTime,\n  modifiedBy: item.json.lastModifiedBy?.user?.displayName,\n  webUrl: item.json.webUrl,\n  folderPath: item.json.parentReference?.path\n}));\n\nreturn [{ json: { count: files.length, files: files } }];"
